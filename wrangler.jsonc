{
  // MOHOR — single Worker: static storefront + /api/* backend on D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mohor",
  "main": "_worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the API wakes the Worker; pages, CSS, JS and images are served
    // directly from Cloudflare's edge (free, unmetered).
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mohor-db", "database_id": "eb1b375e-a0aa-413f-80b2-130082b97b16" }
  ],
  // Uncomment and set your bucket name to upload images straight to R2
  // (the bucket served at images.mohor.me). Otherwise the legacy
  // mohor-uploader worker is used via UPLOADER_URL + UPLOADER_SECRET.
  // "r2_buckets": [ { "binding": "IMAGES", "bucket_name": "YOUR-BUCKET-NAME" } ],
  "vars": {
    "ADMIN_EMAIL": "mushfiqurrahman2222@gmail.com",
    "PUBLIC_ORIGIN": "https://mohor.me",
    "R2_PUBLIC_URL": "https://images.mohor.me/",
    "UPLOADER_URL": "https://mohor-uploader.2022731073.workers.dev/",
    "META_PIXEL_ID": "920711640501746"
  },
  "observability": { "enabled": true }
}
